{
  "name": "jpa-powertools",
  "displayName": "JPA Power Tools",
  "description": "Browse PostgreSQL, MySQL, MariaDB, SQL Server, Oracle, Db2 and other JDBC databases, generate JPA entities and Spring Data repositories, draw ER diagrams from entities or tables (and generate code and SQL from them), and write JPQL with validation, completion and navigation.",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jpaPowertools",
          "title": "JPA Power Tools",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "jpaPowertools": [
        {
          "id": "jpaPowertools.explorer",
          "name": "Databases",
          "icon": "media/activitybar.svg",
          "contextualTitle": "JPA Power Tools"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "jpaPowertools.explorer",
        "contents": "Connect to a database to browse its tables and generate JPA entities.\n[Add Connection](command:jpaPowertools.addConnection)\n[Import from Spring Config](command:jpaPowertools.importSpringDatasource)\nSupports PostgreSQL, MySQL, MariaDB, SQL Server and Oracle out of the box, plus Db2, H2, HSQLDB, Derby, SQLite, Firebird and any JDBC driver with Java 11+."
      }
    ],
    "commands": [
      {
        "command": "jpaPowertools.addConnection",
        "title": "Add Connection…",
        "category": "JPA Power Tools",
        "icon": "$(add)"
      },
      {
        "command": "jpaPowertools.importSpringDatasource",
        "title": "Import Connection from Spring Config…",
        "category": "JPA Power Tools",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "jpaPowertools.editConnection",
        "title": "Edit Connection…",
        "category": "JPA Power Tools",
        "icon": "$(edit)"
      },
      {
        "command": "jpaPowertools.deleteConnection",
        "title": "Delete Connection",
        "category": "JPA Power Tools",
        "icon": "$(trash)"
      },
      {
        "command": "jpaPowertools.refresh",
        "title": "Refresh",
        "category": "JPA Power Tools",
        "icon": "$(refresh)"
      },
      {
        "command": "jpaPowertools.disconnect",
        "title": "Disconnect",
        "category": "JPA Power Tools",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "jpaPowertools.copyJdbcUrl",
        "title": "Copy JDBC URL",
        "category": "JPA Power Tools"
      },
      {
        "command": "jpaPowertools.generateEntities",
        "title": "Generate JPA Entities…",
        "category": "JPA Power Tools",
        "icon": "$(symbol-class)"
      },
      {
        "command": "jpaPowertools.generateJpql",
        "title": "Generate JPQL Query…",
        "category": "JPA Power Tools",
        "icon": "$(symbol-operator)"
      },
      {
        "command": "jpaPowertools.convertToQuery",
        "title": "Convert Derived Query to @Query",
        "category": "JPA Power Tools"
      },
      {
        "command": "jpaPowertools.erdFromEntities",
        "title": "Open ER Diagram from Entities",
        "category": "JPA Power Tools",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "jpaPowertools.erdFromDatabase",
        "title": "Open ER Diagram…",
        "category": "JPA Power Tools",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "jpaPowertools.newErd",
        "title": "New ER Diagram",
        "category": "JPA Power Tools"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "jpaPowertools.editConnection",
          "when": "false"
        },
        {
          "command": "jpaPowertools.deleteConnection",
          "when": "false"
        },
        {
          "command": "jpaPowertools.disconnect",
          "when": "false"
        },
        {
          "command": "jpaPowertools.copyJdbcUrl",
          "when": "false"
        },
        {
          "command": "jpaPowertools.convertToQuery",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "jpaPowertools.addConnection",
          "when": "view == jpaPowertools.explorer",
          "group": "navigation@1"
        },
        {
          "command": "jpaPowertools.refresh",
          "when": "view == jpaPowertools.explorer",
          "group": "navigation@2"
        },
        {
          "command": "jpaPowertools.importSpringDatasource",
          "when": "view == jpaPowertools.explorer",
          "group": "more@1"
        },
        {
          "command": "jpaPowertools.generateEntities",
          "when": "view == jpaPowertools.explorer && jpaPowertools.hasConnections",
          "group": "more@2"
        },
        {
          "command": "jpaPowertools.erdFromEntities",
          "when": "view == jpaPowertools.explorer",
          "group": "more@3"
        },
        {
          "command": "jpaPowertools.newErd",
          "when": "view == jpaPowertools.explorer",
          "group": "more@4"
        }
      ],
      "view/item/context": [
        {
          "command": "jpaPowertools.generateEntities",
          "when": "view == jpaPowertools.explorer && viewItem =~ /^(connection|schema|table)/",
          "group": "inline@1"
        },
        {
          "command": "jpaPowertools.refresh",
          "when": "view == jpaPowertools.explorer && viewItem =~ /^connection/",
          "group": "inline@2"
        },
        {
          "command": "jpaPowertools.generateEntities",
          "when": "view == jpaPowertools.explorer && viewItem =~ /^(connection|schema|table)/",
          "group": "1_generate@1"
        },
        {
          "command": "jpaPowertools.refresh",
          "when": "view == jpaPowertools.explorer && viewItem =~ /^connection/",
          "group": "2_connection@1"
        },
        {
          "command": "jpaPowertools.disconnect",
          "when": "view == jpaPowertools.explorer && viewItem == connection.connected",
          "group": "2_connection@2"
        },
        {
          "command": "jpaPowertools.copyJdbcUrl",
          "when": "view == jpaPowertools.explorer && viewItem =~ /^connection/",
          "group": "2_connection@3"
        },
        {
          "command": "jpaPowertools.editConnection",
          "when": "view == jpaPowertools.explorer && viewItem =~ /^connection/",
          "group": "3_manage@1"
        },
        {
          "command": "jpaPowertools.deleteConnection",
          "when": "view == jpaPowertools.explorer && viewItem =~ /^connection/",
          "group": "3_manage@2"
        },
        {
          "command": "jpaPowertools.erdFromDatabase",
          "when": "view == jpaPowertools.explorer && viewItem =~ /^(connection|schema|table)/",
          "group": "1_generate@2"
        }
      ],
      "editor/context": [
        {
          "command": "jpaPowertools.generateJpql",
          "when": "editorLangId == java",
          "group": "1_modification@90"
        },
        {
          "command": "jpaPowertools.erdFromEntities",
          "when": "editorLangId == java",
          "group": "1_modification@91"
        }
      ]
    },
    "configuration": {
      "title": "JPA Power Tools",
      "properties": {
        "jpaPowertools.javaHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Java 11+ installation used for JDBC-based databases (Db2, H2, HSQLDB, Derby, SQLite, Firebird, generic JDBC). Defaults to `JAVA_HOME`, then `java` on the `PATH`."
        },
        "jpaPowertools.jpql.validation": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Check JPQL in `@Query`, `@NamedQuery` and `createQuery(…)` against the `@Entity` classes in the workspace."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "jpaPowertools.erd",
        "displayName": "ER Diagram",
        "selector": [
          {
            "filenamePattern": "*.erd.json"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src && node --check media/dom.js && node --check media/connection.js && node --check media/generator.js && node --check media/erd.js && node --check media/erd-layout.js",
    "test:unit": "npm run compile && mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "test:db": "npm run compile && mocha --ui tdd --timeout 120000 \"out/test/db/**/*.test.js\"",
    "test": "vscode-test",
    "test:libs": "npm run compile && node scripts/fetch-test-libs.js",
    "package": "vsce package",
    "test:dbs:up": "bash scripts/test-dbs.sh up",
    "test:dbs:down": "bash scripts/test-dbs.sh down pg mysql maria mssql oracle db2",
    "demo:record": "npm run compile && node scripts/record-demo.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/mssql": "^9.1.11",
    "@types/node": "^20.19.43",
    "@types/oracledb": "^6.10.4",
    "@types/pg": "^8.23.1",
    "@types/vscode": "^1.54.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "eslint": "^9.9.1",
    "mocha": "^10.8.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "mssql": "^11.0.2",
    "mysql2": "^3.24.6",
    "oracledb": "^6.10.0",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  },
  "publisher": "izzyjere",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/izzyjere/jpa-powertools"
  },
  "keywords": [
    "jpa",
    "hibernate",
    "spring data",
    "entity",
    "database",
    "postgresql",
    "mysql",
    "oracle",
    "sql server",
    "db2",
    "jdbc",
    "jpql",
    "hql",
    "query",
    "erd",
    "er diagram",
    "ddl"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e3a8a",
    "theme": "dark"
  },
  "homepage": "https://github.com/izzyjere/jpa-powertools#readme",
  "bugs": {
    "url": "https://github.com/izzyjere/jpa-powertools/issues"
  }
}
